{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated Internet Resources",
  "description": "Schema for personal and family curated internet resources.",
  "type": "object",
  "required": ["meta", "scopes", "categories", "resources"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "subtitle", "owner"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "tags", "category", "scopes", "added"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "description": { "type": "string" },
          "notes": { "type": "string" },
          "category": { "type": "string" },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["family", "kids", "personal", "household"]
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "format": {
            "type": "string",
            "enum": [
              "interactive",
              "archive",
              "reference",
              "tool",
              "reading",
              "video",
              "course",
              "game",
              "community"
            ]
          },
          "access": {
            "type": "string",
            "enum": ["free", "freemium", "paid", "open-source", "library"]
          },
          "added": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "featured": { "type": "boolean" }
        }
      }
    }
  }
}
